# byte-strict regeneration tests compare checked-out bytes against fresh LF
# output; Windows autocrlf must not smudge these trees (issue #48)
fixtures/** text eol=lf
results/** text eol=lf
# run artifacts record sha-256 digests of these scripts; a CRLF checkout must
# not change their bytes or the recorded digests (issue #58)
scripts/*.py text eol=lf
# binary fixtures and artifacts never pass the text filter
*.wav binary
*.pdf binary
*.png binary
*.docx binary
*.pptx binary
*.duckdb binary
*.bin binary
# gzip artifacts are binary; the text filter would corrupt them (issue #59 v5 lane)
*.gz binary
